{
  "build": {
    "env": {
      "DJANGO_SETTINGS_MODULE": "jurnalth.settings"
    }
  },
  "builds": [
    {
      "src": "jurnalth/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    },
    {
      "src": "vercel_build.sh",
      "use": "@vercel/static-build"
    }
  ]
}