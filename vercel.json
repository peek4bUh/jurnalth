{
  "build": {
    "env": {
      "DJANGO_SETTINGS_MODULE": "jurnalth.settings"
    }
  },
  "buildCommand": "bash vercel_build.sh",
  "builds": [
    {
      "src": "jurnalth/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "jurnalth/wsgi.py"
    }
  ]
}