<header class="mb-10">
    <div class="flex justify-between sm:items-center sm:justify-between gap-4">
        <div>
            <a href="{% url 'index' %}" class="hover:opacity-80 transition-opacity">
                <h1 class="text-2xl sm:text-3xl font-semibold text-gray-950 tracking-tight">Jurnalth</h1>
            </a>
            <div class="mt-2 h-0.5 w-12 sm:w-16 bg-gray-900"></div>
            {% if description %}
                <p class="mt-2 text-xs sm:text-sm text-gray-500">{{ description }}</p>
            {% endif %}
        </div>
        {% if actions %}
            <div class="flex flex-wrap items-center justify-end gap-2">
                {% for action in actions %}
                    <a href="{% url action.route %}" class="rounded-sm bg-gray-900 px-4 py-2.5 text-center text-sm font-medium text-white transition-colors hover:bg-black">
                        {{ action.label }}
                    </a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</header>